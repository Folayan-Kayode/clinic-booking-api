# Copy to .env for local runs. Never commit the real key.

# Required. The key every request must send as X-API-Key.
API_KEY=local-dev-key

# Leave DATABASE_URL empty to use a local SQLite file (development and tests).
# In production this is your Neon connection string, e.g.
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Used only when DATABASE_URL is empty.
SQLITE_PATH=data/app.db

# Level 5 knobs (defaults match the spec).
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_SECONDS=60
